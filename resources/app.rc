#include "Resource.h"
#include <windows.h>

IDI_APP_ICON ICON "app.ico"

IDR_TRAY_MENU MENU
BEGIN
    POPUP "TrayMenu"
    BEGIN
        MENUITEM "Settings",          IDM_TRAY_SETTINGS
        MENUITEM "Pin/Unpin",         IDM_TRAY_TOGGLE_PIN
        MENUITEM "Pause",             IDM_TRAY_PAUSE
        MENUITEM "Restore Layout",    IDM_TRAY_RESTORE_LAYOUT
        MENUITEM SEPARATOR
        MENUITEM "Exit",              IDM_TRAY_EXIT
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WinIconManagement Settings"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "Settings placeholder for Stage 02+", IDC_SETTINGS_TITLE, 16, 16, 280, 12
END
