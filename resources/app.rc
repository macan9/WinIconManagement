#include "Resource.h"
#include <windows.h>

#pragma code_page(65001)

IDI_APP_ICON ICON "app.ico"

IDR_TRAY_MENU MENU
BEGIN
    POPUP "TrayMenu"
    BEGIN
        MENUITEM L"主设置",          IDM_TRAY_SETTINGS
        MENUITEM L"固定",            IDM_TRAY_TOGGLE_PIN
        MENUITEM L"暂停管理",        IDM_TRAY_PAUSE
        MENUITEM L"重新连接桌面",    IDM_TRAY_RECONNECT_DESKTOP
        MENUITEM L"批量网格移动",    IDM_TRAY_TEST_MOVE_ICON
        MENUITEM L"恢复原始布局",    IDM_TRAY_RESTORE_LAYOUT
        MENUITEM SEPARATOR
        MENUITEM L"退出",            IDM_TRAY_EXIT
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WinIconManagement Settings"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "Settings placeholder for Stage 02+", IDC_SETTINGS_TITLE, 16, 16, 280, 12
END
